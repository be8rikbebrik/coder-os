#!/usr/bin/env bash
# CODER-OS Installer Trigger

set -e

MANIFEST="/etc/coder-os/coder-manifest.json"

echo "============================================="
echo "   CODER-OS System Installer Initiator       "
echo "============================================="

if [ -f "$MANIFEST" ]; then
    echo "[✓] Найдена конфигурация: $MANIFEST"
else
    echo "[i] Конфигурация не найдена. Запуск мастера настройки..."
    coder-setup
fi

if command -v archinstall &> /dev/null; then
    echo "[✓] Запуск установщика archinstall в отдельном окне..."
    kitty --title "CODER-OS Installer" bash -c "
        echo '=====================================================';
        echo '       CODER-OS • Установка базовой системы          ';
        echo '=====================================================';
        sudo archinstall;
        echo '[*] Применяем ваши выбранные инструменты и профиль...';
        sudo /usr/bin/coder-postinstall;
        echo '=====================================================';
        echo ' [✓] Установка CODER-OS завершена!';
        echo '=====================================================';
        read -p 'Нажмите Enter для перезагрузки системы...' && sudo reboot
    "
else
    echo "[!] archinstall не найден."
fi
